<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>LumaDesk</AssemblyName>
    <Version>0.3.0</Version>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="System.Management" Version="8.0.0"/></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="LumaDesk.UiTests"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/app.ico"/></ItemGroup>
</Project>
