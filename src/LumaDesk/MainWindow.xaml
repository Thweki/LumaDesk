<Window x:Class="LumaDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="LumaDesk · Windows" Width="1080" Height="790" MinWidth="860" MinHeight="650" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#D1D1D1" BorderThickness="1" Background="#F3F3F3" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True"><Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#F3F3F3"><Grid>
   <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/><RowDefinition Height="124"/></Grid.RowDefinitions>
   <StackPanel Margin="22,22,18,0"><StackPanel Orientation="Horizontal"><Image Source="/LumaDesk;component/Assets/app.ico" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="LumaDesk" FontWeight="SemiBold" FontSize="18" Margin="10,0,0,0"/></StackPanel><TextBlock Text="显示管理" Foreground="#616161" FontSize="12" Margin="40,5,0,0"/></StackPanel>
   <StackPanel x:Name="Navigation" Grid.Row="1" Margin="10,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   <StackPanel Grid.Row="2" Margin="18,8,18,14"><CheckBox x:Name="HelpSwitch" Content="显示帮助说明" FontSize="12" Margin="4,0,0,14" Click="HelpChanged"/><Border Height="1" Background="#E1E1E1" Margin="0,0,0,8"/><Button Content="打开快捷面板" Click="OpenQuick" Background="Transparent" BorderThickness="0" Padding="8"/><TextBlock Text="简体中文" Foreground="#757575" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Grid><TextBlock x:Name="Breadcrumb" Text="设置 / 显示器" Foreground="#616161" FontSize="12" Margin="24,0,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="&#xE921;" AutomationProperties.Name="最小化" Style="{StaticResource CaptionButton}" Click="MinimizeWindow"/><Button Content="&#xE922;" AutomationProperties.Name="最大化或还原" Style="{StaticResource CaptionButton}" Click="MaximizeWindow"/><Button Content="&#xE8BB;" AutomationProperties.Name="关闭" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow"/></StackPanel></Grid>
   <Border Grid.Row="1" Background="#F3F3F3"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="DisplayTabs" Orientation="Horizontal" Margin="24,2,24,2"/></ScrollViewer></Border>
   <ScrollViewer x:Name="ContentScroll" Grid.Row="2"><StackPanel x:Name="PageContent" Margin="24,16,24,24"/></ScrollViewer>
   <Border Grid.Row="3" BorderBrush="#E1E1E1" BorderThickness="0,1,0,0"><Grid Margin="24,0"><TextBlock x:Name="StatusLabel" Text="正在检测已连接的显示器…" Foreground="#616161" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,110,0"/><TextBlock Text="Windows 原生控制" HorizontalAlignment="Right" Foreground="#757575" FontSize="10"/></Grid></Border>
  </Grid>
 </Grid></Border>
</Window>
