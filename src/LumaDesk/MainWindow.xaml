<Window x:Class="LumaDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LumaDesk"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LumaDesk" Width="1080" Height="790" MinWidth="860" MinHeight="650"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/>
 </shell:WindowChrome.WindowChrome>
 <Border x:Name="ShellSurface" BorderBrush="{DynamicResource ThemeD1D1D1}" BorderThickness="1"
         Background="{DynamicResource ThemeF3F3F3}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="196"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource ThemeFBFBFB}" BorderBrush="{DynamicResource ThemeE1E1E1}" BorderThickness="0,0,1,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="Brand" Orientation="Horizontal" Margin="22,0">
      <Border Width="28" Height="28" Background="{DynamicResource Ink}">
       <Border.OpacityMask><ImageBrush ImageSource="/LumaDesk;component/Assets/brand.png"/></Border.OpacityMask>
      </Border>
      <TextBlock x:Name="BrandName" Text="LumaDesk" FontWeight="SemiBold" FontSize="19" Margin="10,0,0,0"/>
     </StackPanel>
     <ScrollViewer Grid.Row="1" Margin="10,0"><StackPanel x:Name="Navigation"/></ScrollViewer>
     <Button x:Name="QuickLauncher" Grid.Row="2" Margin="10,12" Content="{loc:Loc Key=saf91a997fb}"
             ToolTip="{loc:Loc Key=saf91a997fb}" AutomationProperties.Name="{loc:Loc Key=saf91a997fb}" Click="OpenQuick"/>
    </Grid>
   </Border>
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <TextBlock x:Name="Breadcrumb" Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="12" Margin="28,0,146,0"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Button Content="&#xE921;" AutomationProperties.Name="{loc:Loc Key=window.minimize}" Style="{StaticResource CaptionButton}" Click="MinimizeWindow"/>
      <Button Content="&#xE922;" AutomationProperties.Name="{loc:Loc Key=window.maximize}" Style="{StaticResource CaptionButton}" Click="MaximizeWindow"/>
      <Button Content="&#xE8BB;" AutomationProperties.Name="{loc:Loc Key=window.close}" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow"/>
     </StackPanel>
    </Grid>
    <ScrollViewer x:Name="TabStrip" Grid.Row="1" Margin="28,2,28,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
     <StackPanel x:Name="DisplayTabs" Orientation="Horizontal"/>
    </ScrollViewer>
    <ScrollViewer x:Name="ContentScroll" Grid.Row="2"><StackPanel x:Name="PageContent" Margin="28,12,28,24"/></ScrollViewer>
    <Border Grid.Row="3" BorderBrush="{DynamicResource ThemeE1E1E1}" BorderThickness="0,1,0,0" Padding="28,6">
     <TextBlock x:Name="StatusLabel" Text="{loc:Loc Key=s199b65c642}" Foreground="{DynamicResource Muted}" FontSize="11"
                AutomationProperties.LiveSetting="Polite" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
    </Border>
   </Grid>
  </Grid>
 </Border>
</Window>
